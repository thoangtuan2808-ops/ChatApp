<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatApp.Frontend.Views.ChatRoomPage"
             Title="Chat Room"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <RadialGradientBrush Center="0.5,0" Radius="1.5">
            <GradientStop Color="{StaticResource AuraDarkBgTop}" Offset="0.0" />
            <GradientStop Color="{StaticResource AuraDarkBg}" Offset="1.0" />
        </RadialGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- HEADER (CỤM ĐIỀU HƯỚNG & THÔNG TIN CHAT) -->
        <Border Grid.Row="0" Stroke="{StaticResource AuraGlassStrokeBrush}" Background="#11ffffff" StrokeThickness="1" Margin="0" Padding="10,40,10,15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,25,25" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">

                <!-- Back Button -->
                <Border Grid.Column="0" Stroke="{StaticResource AuraGlassStrokeBrush}" Background="{StaticResource AuraGlassBgBrush}" StrokeThickness="1" HeightRequest="40" WidthRequest="40" VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Path Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" Fill="White" HorizontalOptions="Center" VerticalOptions="Center" Scale="0.8"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackButtonClicked" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- User Info -->
                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <Grid WidthRequest="40" HeightRequest="40">
                        <Ellipse Fill="#334155" WidthRequest="40" HeightRequest="40"/>
                        <Image Source="dotnet_bot.png" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"/>
                        <Ellipse WidthRequest="10" HeightRequest="10" Fill="{StaticResource AuraGreenOnline}" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,2,2" IsVisible="{Binding IsOnline}">
                            <Ellipse.Shadow>
                                <Shadow Brush="{StaticResource AuraGreenOnline}" Radius="5" Opacity="1"/>
                            </Ellipse.Shadow>
                        </Ellipse>
                    </Grid>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{Binding ChatName}" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                        <Label Text="Online" FontSize="11" TextColor="{StaticResource AuraGreenOnline}" IsVisible="{Binding IsOnline}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Actions (Call / Video) -->
                <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                    <Border Stroke="{StaticResource AuraGlassStrokeBrush}" Background="{StaticResource AuraGlassBgBrush}" StrokeThickness="1" HeightRequest="40" WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Path Data="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 1.01-.63 1.01-1.18v-3.45c0-.54-.45-.99-.99-.99z" Fill="White" HorizontalOptions="Center" VerticalOptions="Center" Scale="0.7"/>
                    </Border>
                    <Border Stroke="{StaticResource AuraGlassStrokeBrush}" Background="{StaticResource AuraGlassBgBrush}" StrokeThickness="1" HeightRequest="40" WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Path Data="M21 6.5l-4 4V7c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h13c.55 0 1-.45 1-1v-3.5l4 4v-11z" Fill="White" HorizontalOptions="Center" VerticalOptions="Center" Scale="0.7"/>
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- MESSAGE LIST (CỤM HIỂN THỊ TIN NHẮN) -->
        <CollectionView x:Name="MessagesListView" Grid.Row="1" ItemsSource="{Binding Messages}" SelectionMode="None" Margin="0,10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <ContentView Padding="15, 8">
                        <Border StrokeThickness="1" Padding="15, 10" MaximumWidthRequest="280">
                            <!-- DataTriggers định dạng màu và vị trí (Bong bóng chat) -->
                            <Border.Triggers>
                                <!-- Tin nhắn của MÌNH -->
                                <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="True">
                                    <Setter Property="HorizontalOptions" Value="End" />
                                    <Setter Property="Background" Value="{StaticResource AuraBlue}" />
                                    <Setter Property="Stroke" Value="{StaticResource AuraBlue}" />
                                    <Setter Property="StrokeShape">
                                        <Setter.Value>
                                            <RoundRectangle CornerRadius="20, 20, 0, 20" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Shadow">
                                        <Setter.Value>
                                            <Shadow Brush="{StaticResource AuraBlue}" Offset="0,2" Radius="5" Opacity="0.4"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <!-- Tin nhắn của NGƯỜI KHÁC -->
                                <DataTrigger TargetType="Border" Binding="{Binding IsMine}" Value="False">
                                    <Setter Property="HorizontalOptions" Value="Start" />
                                    <Setter Property="Background" Value="{StaticResource AuraGlassBgBrush}" />
                                    <Setter Property="Stroke" Value="{StaticResource AuraGlassStrokeBrush}" />
                                    <Setter Property="StrokeShape">
                                        <Setter.Value>
                                            <RoundRectangle CornerRadius="20, 20, 20, 0" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Border.Triggers>

                            <VerticalStackLayout Spacing="5">
                                <!-- Nội dung tin nhắn -->
                                <Label Text="{Binding Text}" FontSize="14" LineBreakMode="WordWrap">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="False">
                                            <Setter Property="TextColor" Value="#e2e8f0" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Thời gian -->
                                <Label Text="{Binding Time}" FontSize="10" HorizontalOptions="End">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="True">
                                            <Setter Property="TextColor" Value="#bae6fd" />
                                            <!-- Cyan nhạt -->
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsMine}" Value="False">
                                            <Setter Property="TextColor" Value="{StaticResource AuraTextMuted}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- INPUT AREA (CỤM NHẬP TIN NHẮN) -->
        <Border Grid.Row="2" Stroke="{StaticResource AuraGlassStrokeBrush}" Background="#cc020617" StrokeThickness="1" Margin="0" Padding="10,15,10,25">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0" />
            </Border.StrokeShape>

            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">

                <!-- Attachment Button -->
                <Border Grid.Column="0" Stroke="Transparent" Background="Transparent" HeightRequest="40" WidthRequest="40">
                    <Path Data="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z" Fill="{StaticResource AuraTextMuted}" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- Text Input -->
                <Border Grid.Column="1" Stroke="{StaticResource AuraGlassStrokeBrush}" Background="{StaticResource AuraGlassBgBrush}" StrokeThickness="1" HeightRequest="45">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22.5" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry x:Name="MessageInput" Grid.Column="0" Placeholder="Type a message..." PlaceholderColor="{StaticResource AuraTextMuted}" TextColor="White" VerticalOptions="Center" Margin="15,0,0,0" BackgroundColor="Transparent"/>
                        <!-- Mic Icon inside input box -->
                        <Path Grid.Column="1" Data="M12 14c1.66 0 2.99-1.34 2.99-3L15 5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72h-1.7z" Fill="{StaticResource AuraTextMuted}" VerticalOptions="Center" Margin="0,0,15,0" Scale="0.8"/>
                    </Grid>
                </Border>

                <!-- Send Button (Glowing) -->
                <Border Grid.Column="2" Stroke="Transparent" Background="{StaticResource AuraBlue}" StrokeThickness="0" HeightRequest="45" WidthRequest="45">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22.5" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource AuraBlue}" Offset="0,2" Radius="6" Opacity="0.8"/>
                    </Border.Shadow>
                    <Path Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" Fill="White" HorizontalOptions="Center" VerticalOptions="Center" Scale="0.7" Margin="3,0,0,0"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSendButtonClicked" />
                    </Border.GestureRecognizers>
                </Border>

            </Grid>
        </Border>
    </Grid>
</ContentPage>
