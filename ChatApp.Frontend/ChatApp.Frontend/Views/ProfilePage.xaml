<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatApp.Frontend.Views.ProfilePage"
             Title="Profile"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <RadialGradientBrush Center="0.5,0" Radius="1.2">
            <GradientStop Color="{StaticResource AuraDarkBgTop}" Offset="0.0" />
            <GradientStop Color="{StaticResource AuraDarkBg}" Offset="1.0" />
        </RadialGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20, 40, 20, 10" ColumnDefinitions="Auto, *, Auto">
            <Border Grid.Column="0" Stroke="{StaticResource AuraGlassStrokeBrush}" Background="{StaticResource AuraGlassBgBrush}" StrokeThickness="1" HeightRequest="40" WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Path Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" Fill="White" HorizontalOptions="Center" VerticalOptions="Center" Scale="0.8"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackButtonClicked" />
                </Border.GestureRecognizers>
            </Border>
            <Label Grid.Column="1" Text="PROFILE" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" CharacterSpacing="2"/>
            <Border Grid.Column="2" Stroke="{StaticResource AuraGlassStrokeBrush}" Background="{StaticResource AuraGlassBgBrush}" StrokeThickness="1" HeightRequest="40" WidthRequest="40">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <!-- Edit Icon -->
                <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" Fill="White" HorizontalOptions="Center" VerticalOptions="Center" Scale="0.7"/>
            </Border>
        </Grid>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20, 10, 20, 40" Spacing="25">

                <!-- CỤM 1: NHẬN DIỆN CÁ NHÂN (IDENTITY) -->
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Grid WidthRequest="120" HeightRequest="120" HorizontalOptions="Center">
                        <!-- Avatar Border / Crop intent UI -->
                        <Ellipse Stroke="{StaticResource AuraCyanBrush}" StrokeThickness="2" WidthRequest="110" HeightRequest="110" HorizontalOptions="Center" VerticalOptions="Center">
                            <Ellipse.Shadow>
                                <Shadow Brush="{StaticResource AuraCyanBrush}" Offset="0,0" Radius="15" Opacity="0.5"/>
                            </Ellipse.Shadow>
                        </Ellipse>
                        <!-- Image -->
                        <Ellipse WidthRequest="100" HeightRequest="100" Fill="#1affffff" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Image Source="{Binding AvatarUrl}" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"/>

                        <!-- Online Badge -->
                        <Ellipse WidthRequest="20" HeightRequest="20" Fill="{StaticResource AuraDarkBg}" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,10,10"/>
                        <Ellipse WidthRequest="14" HeightRequest="14" Fill="{StaticResource AuraGreenOnline}" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,13,13" IsVisible="{Binding IsOnline}">
                            <Ellipse.Shadow>
                                <Shadow Brush="{StaticResource AuraGreenOnline}" Radius="8" Opacity="1"/>
                            </Ellipse.Shadow>
                        </Ellipse>
                    </Grid>

                    <Label Text="{Binding DisplayName}" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="{Binding Username}" FontSize="14" TextColor="{StaticResource AuraCyan}" HorizontalOptions="Center"/>
                    <Label Text="{Binding Bio}" FontSize="14" TextColor="{StaticResource AuraTextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="20,5,20,0"/>
                </VerticalStackLayout>

                <!-- CỤM 2: KẾT NỐI NHANH (NETWORKING) -->
                <Border Stroke="{StaticResource AuraPurple}" Background="#11a855f7" StrokeThickness="1" HeightRequest="60" Padding="15,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Path Grid.Column="0" Data="M3 3h8v8H3zm2 2v4h4V5zm8-2h8v8h-8zm2 2v4h4V5zM3 13h8v8H3zm2 2v4h4v-4zm13-2h3v2h-3zm-3 0h2v2h-2zm3 3h3v2h-3zm-2 3h2v2h-2zm-3-3h2v2h-2zm3 3h2v2h-2zm-3-3h2v2h-2zm0-3h2v2h-2z" Fill="{StaticResource AuraPurple}" VerticalOptions="Center" Scale="1.2"/>
                        <Label Grid.Column="1" Text="Mã QR cá nhân của tôi" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" Margin="15,0,0,0"/>
                        <Path Grid.Column="2" Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" Fill="{StaticResource AuraTextMuted}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- CỤM 3: QUẢN LÝ TÀI KHOẢN & BẢO MẬT -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="TÀI KHOẢN &amp; BẢO MẬT" FontSize="12" TextColor="{StaticResource AuraTextMuted}" FontAttributes="Bold" CharacterSpacing="1.5"/>
                    <Border Stroke="{StaticResource AuraGlassStrokeBrush}" Background="{StaticResource AuraGlassBgBrush}" StrokeThickness="1" Padding="15,5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="0">
                            <!-- Info -->
                            <Grid ColumnDefinitions="Auto, *, Auto" HeightRequest="50">
                                <Path Grid.Column="0" Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" Fill="{StaticResource AuraCyanBrush}" VerticalOptions="Center" Scale="0.8"/>
                                <Label Grid.Column="1" Text="Thông tin định danh (SĐT/Email)" TextColor="White" VerticalOptions="Center" Margin="15,0,0,0"/>
                                <Path Grid.Column="2" Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" Fill="{StaticResource AuraTextMuted}" VerticalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource AuraGlassStrokeBrush}"/>
                            <!-- 2FA -->
                            <Grid ColumnDefinitions="Auto, *, Auto" HeightRequest="50">
                                <Path Grid.Column="0" Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z" Fill="{StaticResource AuraCyanBrush}" VerticalOptions="Center" Scale="0.8"/>
                                <Label Grid.Column="1" Text="Đổi mật khẩu &amp; 2FA" TextColor="White" VerticalOptions="Center" Margin="15,0,0,0"/>
                                <Path Grid.Column="2" Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" Fill="{StaticResource AuraTextMuted}" VerticalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource AuraGlassStrokeBrush}"/>
                            <!-- Devices -->
                            <Grid ColumnDefinitions="Auto, *, Auto" HeightRequest="50">
                                <Path Grid.Column="0" Data="M4 6h18V4H4c-1.1 0-2 .9-2 2v11H0v3h14v-3H4V6zm19 2h-6c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h6c.55 0 1-.45 1-1V9c0-.55-.45-1-1-1zm-1 9h-4v-7h4v7z" Fill="{StaticResource AuraCyanBrush}" VerticalOptions="Center" Scale="0.8"/>
                                <Label Grid.Column="1" Text="Thiết bị đã đăng nhập" TextColor="White" VerticalOptions="Center" Margin="15,0,0,0"/>
                                <Path Grid.Column="2" Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" Fill="{StaticResource AuraTextMuted}" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- CỤM 4: CÀI ĐẶT ỨNG DỤNG (APP SETTINGS) -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="CÀI ĐẶT ỨNG DỤNG" FontSize="12" TextColor="{StaticResource AuraTextMuted}" FontAttributes="Bold" CharacterSpacing="1.5"/>
                    <Border Stroke="{StaticResource AuraGlassStrokeBrush}" Background="{StaticResource AuraGlassBgBrush}" StrokeThickness="1" Padding="15,5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="0">
                            <!-- Notifications -->
                            <Grid ColumnDefinitions="Auto, *, Auto" HeightRequest="50">
                                <Path Grid.Column="0" Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" Fill="White" VerticalOptions="Center" Scale="0.8"/>
                                <Label Grid.Column="1" Text="Thông báo &amp; Âm thanh" TextColor="White" VerticalOptions="Center" Margin="15,0,0,0"/>
                                <Switch Grid.Column="2" IsToggled="True" OnColor="{StaticResource AuraCyan}" VerticalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource AuraGlassStrokeBrush}"/>
                            <!-- Privacy -->
                            <Grid ColumnDefinitions="Auto, *, Auto" HeightRequest="50">
                                <Path Grid.Column="0" Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" Fill="White" VerticalOptions="Center" Scale="0.8"/>
                                <Label Grid.Column="1" Text="Quyền riêng tư &amp; Block list" TextColor="White" VerticalOptions="Center" Margin="15,0,0,0"/>
                                <Path Grid.Column="2" Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" Fill="{StaticResource AuraTextMuted}" VerticalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource AuraGlassStrokeBrush}"/>
                            <!-- Theme -->
                            <Grid ColumnDefinitions="Auto, *, Auto" HeightRequest="50">
                                <Path Grid.Column="0" Data="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z" Fill="White" VerticalOptions="Center" Scale="0.8"/>
                                <Label Grid.Column="1" Text="Giao diện (Dark/Light)" TextColor="White" VerticalOptions="Center" Margin="15,0,0,0"/>
                                <Label Grid.Column="2" Text="Dark" TextColor="{StaticResource AuraCyan}" VerticalOptions="Center" FontAttributes="Bold"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- CỤM 5: HÀNH ĐỘNG (ACTIONS) -->
                <VerticalStackLayout Spacing="15" Margin="0,10,0,0">
                    <Border Stroke="{StaticResource AuraGlassStrokeBrush}" Background="{StaticResource AuraGlassBgBrush}" StrokeThickness="1" HeightRequest="50">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLogoutTapped" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="25" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                            <Path Data="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" Fill="#f87171" VerticalOptions="Center" Scale="0.8"/>
                            <Label Text="Đăng xuất" TextColor="#f87171" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <Label Text="Xóa tài khoản vĩnh viễn" TextColor="#ef4444" FontSize="13" TextDecorations="Underline" HorizontalOptions="Center" Margin="0,10,0,0"/>
                </VerticalStackLayout>

                <Label Text="{Binding MemberSince}" FontSize="12" TextColor="{StaticResource AuraTextMuted}" HorizontalOptions="Center" Margin="0,10,0,0"/>
                <Label Text="{Binding UserId}" FontSize="10" TextColor="#475569" HorizontalOptions="Center"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
